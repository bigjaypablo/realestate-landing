# Used by index.html (SEO / Open Graph). Rebuild after changing.
VITE_SITE_URL="https://www.example.com"
VITE_SEO_TITLE="Your Realty Name | Buy or Sell a Home in Your City"
VITE_SEO_DESCRIPTION="Buying or selling a home in Your City? Talk to a local agent and get clear guidance every step of the way."
VITE_OG_IMAGE="https://www.example.com/og-image.jpg"

# Analytics: leave blank to disable. Nothing loads without a valid ID.
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""

# Lead delivery: Zapier / Make / GoHighLevel / Apps Script / your own serverless proxy.
# Never put private CRM API keys in a VITE_ variable (they ship to the browser).
VITE_LEAD_WEBHOOK_URL=""
